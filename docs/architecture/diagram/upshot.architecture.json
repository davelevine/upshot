  "cards": [
    {
      "dot": "cyan",
      "title": "Schedule",
      "items": [
        "The Worker's cron starts the build at :27; GitHub's schedule is the fallback",
        "Stories are pruned after 90 days"
      ]
    },
    {
      "dot": "amber",
      "title": "Reader",
      "items": [
        "Article text is extracted at build time, so nothing fetches from publishers",
        "Articles render in a sandboxed frame"
      ]
    },
    {
      "dot": "violet",
      "title": "Sync",
      "items": [
        "Optional · no account, email or password",
        "A device joins with a sync code or QR code"

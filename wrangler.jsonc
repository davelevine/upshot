// Cloudflare Workers with static assets. Workers Builds deploys main and builds every other branch as a Preview.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "upshot",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Code runs for the reader, for the licensed fonts (from R2, at paths without a dot for this reason), and for pages
    // (paths without a dot), which get a per-request CSP nonce. Files (data.json, app.js, icons) are free static assets.
    // Wrangler rejects a narrower rule such as "/fonts/licensed/*" next to "/*", and "!/*.*" wins.
    "run_worker_first": ["/*", "!/*.*"]
  },
  // The reader's stored articles. The Worker only reads them, so Previews safely share the namespace.
  "kv_namespaces": [{ "binding": "ARTICLES", "id": "1bba8ed2e55040b1b00a7f32be0ea5d3" }],
  // Read-state sync: its own Worker, upshot-sync (sync/), since Cloudflare makes no preview URLs for a Worker that defines
  // a Durable Object. Previews reach the same one; cookies belong to a host, so a preview's syncs are its own.
  "services": [{ "binding": "SYNC", "service": "upshot-sync" }],
  // The licensed fonts (worker.js). A private bucket of its own (docs/setup.md): a binding can read and
  // write its whole bucket, so this one holds nothing else. Previews read the same files.
  "r2_buckets": [{ "binding": "FONTS", "bucket_name": "upshot-fonts" }],
  "routes": [{ "pattern": "upshot.levine.io", "custom_domain": true }],
  // Explicit, because with routes set both default to off: the site lives only on its domain, while PR branch builds
  // still get a preview URL on workers.dev.
  "workers_dev": false,
  "preview_urls": true,
  // Workers Logs: a few days of the Worker's requests and errors, for debugging after the fact. Free-tier allowance.
  "observability": { "enabled": true },
  // Starts the Build workflow on time (worker.js); site/app.js counts down to the same slots. Only the deployed Worker
  // runs it, never a Preview. Needs the GITHUB_DISPATCH_TOKEN secret (docs/setup.md).
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "BUILD_REPO": "davelevine/upshot" },
  "previews": {
    "kv_namespaces": [{ "binding": "ARTICLES", "id": "1bba8ed2e55040b1b00a7f32be0ea5d3" }],
    "services": [{ "binding": "SYNC", "service": "upshot-sync" }],
    "r2_buckets": [{ "binding": "FONTS", "bucket_name": "upshot-fonts" }]
  }
}

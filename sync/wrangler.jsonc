// upshot-sync: read-state sync's devices and Durable Objects (worker.js, account.js). Separate from the site's Worker
// because Cloudflare makes no preview URLs for a Worker that defines a Durable Object. Deploy it before the site's Worker
// (docs/setup.md).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "upshot-sync",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "READER", "class_name": "Reader" },
      { "name": "CODES", "class_name": "Codes" }
    ]
  },
  // SQLite-backed, the only kind the Free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reader", "Codes"] }],
  // New readers and codes entered, per address: plenty for a person, little for a script.
  "ratelimits": [{ "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // No route and no workers.dev address: only the site's Worker reaches it, over a service binding.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}

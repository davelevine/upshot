# Content-Security-Policy for every page. Inline scripts are allowed only by hash (the theme, platform and column-width bootstrap in
# index.html and the reader frame's swipe/keyboard relay in app.js); tests/csp.test.js keeps the hashes current.
# img-src is open to https because the reader shows article images. frame-src is 'none': the reader's frame is srcdoc, which
# frame-src doesn't govern, and no page from another site is ever framed.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-n3fYwS6SImHVLdSyw1AGEf0FlCh3SWvGBVZzEK0iyVc=' 'sha256-OUTG7bLeQ8vifALxqfZES3pj/VQKd5hYPgk1+c0HBmg='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src https:; frame-src 'none'; connect-src 'self'; font-src 'self' data:; manifest-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Source icons don't change between visits, so a day without asking again: each one otherwise costs a round trip on every visit.
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# app.js is loaded as /app.js?v=<hash of its contents> (tests/assets.test.js), so a changed file is a new URL: kept a year.
/app.js
  Cache-Control: public, max-age=31536000, immutable
